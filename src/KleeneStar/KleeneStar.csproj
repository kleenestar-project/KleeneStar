<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>0.0.3</Version>
		<AssemblyVersion>$(VERSION).0</AssemblyVersion>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>kleenestar.ico</ApplicationIcon>
		<Authors>kleenestar.project@gmail.com</Authors>
		<StartupObject>KleeneStar.Program</StartupObject>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm;</RuntimeIdentifiers>
		<RepositoryUrl>https://github.com/kleenestar-project/KleeneStar</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<ContainerDevelopmentMode>Regular</ContainerDevelopmentMode>
		<DockerfileContext>..</DockerfileContext>
		<DockerfileFile>..\..\Dockerfile</DockerfileFile>
		<DockerfileRepository>kleenestarorg/kleenestar</DockerfileRepository>
		<ContainerImageTag>$(VERSION)-alpha</ContainerImageTag>
		<DockerfileBuildArguments Condition="'$(WEBEXPRESS_FEED)' != ''">--build-context nuget=$(WEBEXPRESS_FEED)</DockerfileBuildArguments>
		<DockerfileRunArguments>-p 8080:8080</DockerfileRunArguments>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(Configuration)' != 'DebugLocal'">
		<PackageReference Include="WebExpress.WebApp" Version="2.0.0-alpha" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'DebugLocal'">
		<ProjectReference Include="..\..\..\WebExpress.WebApp\src\WebExpress.WebApp\WebExpress.WebApp.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="kleenestar.ico" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="data\icons\kleenestar.svg">
	    <LogicalName>$(MSBuildProjectName).Assets.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\KleeneStar.Core\src\KleeneStar.Core\KleeneStar.Core.csproj" />
	  <ProjectReference Include="..\..\..\KleeneStar.Portal\src\KleeneStar.Portal\KleeneStar.Portal.csproj" />
	  <ProjectReference Include="..\..\..\KleeneStar.Templates\src\KleeneStar.Templates\KleeneStar.Templates.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="settings\*.json;data\db\readme.md;data\icons\*.svg">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- packaging runs the built Windows executable, so it is skipped where there is none: on
	     another OS, and inside a container build (the .NET SDK images set DOTNET_RUNNING_IN_CONTAINER) -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">
		<Exec Command="$(SolutionDir)$(AssemblyName)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).exe -s $(SolutionDir)..\$(SolutionName).spec -c $(Configuration) -t $(TargetFramework) -o $(SolutionDir)..\pkg\$(Configuration)" />
	</Target>

</Project>
