{
  // The settings of the web server. Every json file in this directory is merged into one
  // configuration; this file is merged last, so its values win over those of the other files.
  "WebExpress": {

    // Log file. Mode: Off (no file), Append (keep adding) or Override (start afresh).
    "Log": {
      "Mode": "Off",
      "Debug": false,
      "Path": "/var/log/",
      "Encoding": "utf-8",
      "FileName": "webexpress.log",
      "TimePattern": "dd.MM.yyyy HH:mm:ss"
    },

    // The addresses the server listens on. An https endpoint also needs "PfxFile" and "Password".
    "Endpoints": [
      { "Uri": "http://localhost/" }
    ],

    // Optional fine-tuning of the underlying Kestrel server. A value left out keeps its default.
    "Kestrel": {
      "MaxConcurrentConnections": 300,
      "MaxRequestBodySize": 3000000000,
      "MaxRequestHeadersTotalSize": 65536
    },

    "Culture": "en-US",

    // The sign-in issues signed tokens instead of keeping a session on the server, and it
    // refuses to run without this section: no key is invented per process, because one invented
    // here would sign tokens the next start no longer accepts.
    //
    // "SigningKey" is at least 256 random bits, Base64. The one below belongs to this checkout
    // and to nothing else - a deployment generates its own and keeps it out of the repository
    // ("WEBEXPRESS_WebExpress__Authentication__SigningKey" is the environment variable for it).
    //
    // "RequireHttps" is false because the endpoint above is plain http: the browser refuses a
    // "__Host-"-prefixed cookie over it, so the credential would never arrive and every request
    // would be anonymous. An https deployment removes it and keeps the protected cookie names.
    "Authentication": {
      "Issuer": "kleenestar",
      "Audience": "kleenestar",
      "SigningKey": "TrNsUjfTvo8M4OHFsr/MlqkYZ97KVwaTkUG/ZfSQ9nE=",
      "RequireHttps": false,

      // The access credential expires on its own and nothing in the browser renews it: the
      // refresh endpoint exists (POST /api/auth/refresh) but no page calls it, so the default
      // five minutes would sign every user out mid-sentence, silently. Until a client-side
      // renewal ships, the credential is given a working day; the refresh credential still
      // bounds the whole grant at its own default of seven days.
      "AccessTokenLifetime": "12:00:00",
      "TokenStorePath": "./data/tokens",
      "ApplicationId": "kleenestar.core.kleenestarapplication"
    },

    "PackagePath": "./packages",
    "AssetPath": "./assets",
    "DataPath": "./data",
    "ContextPath": ""
  },

  // The settings of the installed plugins, one section per plugin id. A plugin ships its
  // defaults in its own file next to this one (KleeneStar's database settings live in
  // kleenestar.core.settings.json); a value placed here overrides them.
  "Plugins": {
  }
}
